{
  "name": "flux",
  "version": "1.0.0",
  "scripts": {
    "build": "bun scripts/check.ts --stage build",
    "dev": "turbo run dev",
    "format:check": "bun scripts/check.ts --stage format:check",
    "format:fix": "turbo run format:fix",
    "lint": "bun scripts/check.ts --stage lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "bun scripts/check.ts --stage typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "tools:install": "bun scripts/install-tools.ts",
    "check:fast": "bun scripts/check.ts --fast",
    "check": "bun scripts/check.ts --full",
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "scan": "bun scripts/scan.ts",
    "scan:dependencies": "bun scripts/scan.ts --dependencies",
    "scan:secrets": "bun scripts/scan.ts --secrets",
    "test:unit": "bun scripts/check.ts --stage test:unit",
    "test:integration": "bun scripts/check.ts --stage test:integration",
    "migrate:check": "bun scripts/check.ts --stage migrate:check"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22.23.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
