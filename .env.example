# ============================================================================
# FLUX PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# Primary Environment
FLUX_PRIMARY.ENV="local"

# HTTP Server Configuration
FLUX_SERVER.PORT="8080"
FLUX_SERVER.READ_TIMEOUT="30"
FLUX_SERVER.WRITE_TIMEOUT="30"
FLUX_SERVER.IDLE_TIMEOUT="60"
FLUX_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3002"

# PostgreSQL Database Configuration
FLUX_DATABASE.HOST="localhost"
FLUX_DATABASE.PORT="5432"
FLUX_DATABASE.USER="postgres"
FLUX_DATABASE.PASSWORD="your_database_password"
FLUX_DATABASE.NAME="flux"
FLUX_DATABASE.SSL_MODE="disable"
FLUX_DATABASE.MAX_OPEN_CONNS="25"
FLUX_DATABASE.MAX_IDLE_CONNS="25"
FLUX_DATABASE.CONN_MAX_LIFETIME="300"
FLUX_DATABASE.CONN_MAX_IDLE_TIME="300"

# Redis Cache & Queue Configuration
FLUX_REDIS.ADDRESS="localhost:6379"

# Authentication & Security
FLUX_AUTH.SECRET_KEY="your_auth_secret_key"
CLERK_SECRET_KEY="your_clerk_backend_secret_key"

# External Service Integrations
FLUX_INTEGRATION.RESEND_API_KEY="your_resend_api_key"

# Observability Configuration
FLUX_OBSERVABILITY.SERVICE_NAME="flux"
FLUX_OBSERVABILITY.ENVIRONMENT="development"
FLUX_OBSERVABILITY.LOGGING.LEVEL="debug"
FLUX_OBSERVABILITY.LOGGING.FORMAT="console"

# New Relic APM Configuration
FLUX_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="your_new_relic_license_key"
FLUX_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
FLUX_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
FLUX_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# Health Check Settings
FLUX_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
FLUX_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
FLUX_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
FLUX_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"

# AWS S3 Storage Configuration
FLUX_AWS.REGION="ap-south-1"
FLUX_AWS.ACCESS_KEY_ID="your_aws_access_key"
FLUX_AWS.UPLOAD_BUCKET="flux-storage"
FLUX_AWS.SECRET_ACCESS_KEY="your_aws_secret_key"
FLUX_AWS.ENDPOINT_URL=""

# Frontend Web Application Configuration
VITE_API_URL="http://localhost:8080"

# Custom Domains & Edge Routing
PLATFORM_DOMAIN="localhost"
INTERNAL_API_KEY="super-secret-internal-token-change-in-prod"
