{
	on_demand_tls {
		ask http://backend:8080/api/internal/tls/ask?token={$INTERNAL_API_KEY}
		interval 2m
		burst 5
	}
}

# The main application platform domain
{$PLATFORM_DOMAIN} {
	reverse_proxy backend:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-Port {server_port}
	}
}

# On-demand TLS for all other custom domains
https:// {
	tls {
		on_demand
	}

	reverse_proxy backend:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-Port {server_port}
	}
}
