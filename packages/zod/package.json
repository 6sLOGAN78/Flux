{
  "name": "@flux/zod",
  "version": "1.0.0",
  "description": "Package which exports all Flux zod schemas and types",
  "type": "module",
  "scripts": {
    "build": "tsc --typeRoots ../openapi/node_modules/@types,./node_modules/@types && tsc-alias",
    "dev": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "clean": "rimraf dist tsconfig.tsbuildinfo .turbo node_modules",
    "format:check": "../../tmp/tools/biome format src",
    "lint": "../../tmp/tools/biome lint src --error-on-warnings",
    "typecheck": "tsc --noEmit --typeRoots ../openapi/node_modules/@types,./node_modules/@types",
    "test": "bun test src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsc-alias": "^1.8.12",
    "typescript": "^5.8.2"
  }
}
