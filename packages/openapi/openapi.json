{
  "openapi": "3.0.2",
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check Endpoint",
        "tags": [
          "Health"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Service operational status",
                      "example": "ok"
                    },
                    "database": {
                      "type": "string",
                      "description": "Database connectivity status",
                      "example": "connected"
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ],
                  "description": "System health check response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/links": {
      "post": {
        "summary": "Shorten a URL link",
        "tags": [
          "Links"
        ],
        "parameters": [],
        "requestBody": {
          "description": "Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "destinationUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Destination URL to shorten",
                    "example": "https://example.com/long-url"
                  },
                  "customCode": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "description": "Optional custom short code slug",
                    "example": "my-custom-alias"
                  }
                },
                "required": [
                  "destinationUrl"
                ],
                "description": "Input payload for creating a shortened link"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique link identifier (UUID)",
                      "example": "123e4567-e89b-12d3-a456-426614174000"
                    },
                    "shortCode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "Custom or generated Base62 short code",
                      "example": "xyz123"
                    },
                    "destinationUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "Target URL for redirection",
                      "example": "https://example.com/target-page"
                    },
                    "tenantId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Tenant identifier for multi-tenant isolation"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link creation timestamp in ISO 8601 format"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link last update timestamp in ISO 8601 format"
                    }
                  },
                  "required": [
                    "id",
                    "shortCode",
                    "destinationUrl",
                    "createdAt",
                    "updatedAt"
                  ],
                  "description": "Shortened Link entity"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid destination URL"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/links/{shortCode}": {
      "get": {
        "summary": "Get shortened link details",
        "tags": [
          "Links"
        ],
        "parameters": [
          {
            "name": "shortCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "xyz123"
            },
            "description": "Base62 short code slug"
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique link identifier (UUID)",
                      "example": "123e4567-e89b-12d3-a456-426614174000"
                    },
                    "shortCode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "Custom or generated Base62 short code",
                      "example": "xyz123"
                    },
                    "destinationUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "Target URL for redirection",
                      "example": "https://example.com/target-page"
                    },
                    "tenantId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Tenant identifier for multi-tenant isolation"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link creation timestamp in ISO 8601 format"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link last update timestamp in ISO 8601 format"
                    }
                  },
                  "required": [
                    "id",
                    "shortCode",
                    "destinationUrl",
                    "createdAt",
                    "updatedAt"
                  ],
                  "description": "Shortened Link entity"
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Link not found"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": [
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "description": "Authenticated user identifier",
                      "example": "usr_998127"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "description": "User email address",
                      "example": "user@example.com"
                    },
                    "status": {
                      "type": "string",
                      "description": "Session status",
                      "example": "authenticated"
                    }
                  },
                  "required": [
                    "user_id",
                    "email",
                    "status"
                  ],
                  "description": "Authenticated user session response"
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Unauthorized - Invalid JWT"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "summary": "Get global analytics summary",
        "tags": [
          "Analytics"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalClicks": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total click count across all links",
                      "example": 42150
                    },
                    "uniqueVisitors": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total unique visitor IP count",
                      "example": 31200
                    },
                    "activeLinks": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total active short links",
                      "example": 128
                    }
                  },
                  "required": [
                    "totalClicks",
                    "uniqueVisitors",
                    "activeLinks"
                  ],
                  "description": "Global analytics summary statistics"
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/links/{id}": {
      "get": {
        "summary": "Get detailed time-series metrics for a specific link",
        "tags": [
          "Links"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "123e4567-e89b-12d3-a456-426614174000"
            },
            "description": "Link UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "linkId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Target link UUID"
                    },
                    "shortCode": {
                      "type": "string",
                      "description": "Short code slug",
                      "example": "xyz123"
                    },
                    "totalClicks": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total click count for this link",
                      "example": 1540
                    },
                    "clicksByDate": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "example": "2026-08-08"
                          },
                          "clicks": {
                            "type": "integer",
                            "minimum": 0,
                            "example": 320
                          }
                        },
                        "required": [
                          "date",
                          "clicks"
                        ]
                      },
                      "description": "Time-series daily click breakdown"
                    }
                  },
                  "required": [
                    "linkId",
                    "shortCode",
                    "totalClicks",
                    "clicksByDate"
                  ],
                  "description": "Detailed analytics metrics for a specific link"
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Link metrics not found"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "info": {
    "title": "Flux Platform REST API",
    "version": "1.0.0",
    "description": "Production-grade URL shortening, dynamic link routing, and real-time analytics API.",
    "contact": {
      "name": "Flux API Engineering Team",
      "email": "support@flux.dev",
      "url": "https://flux.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.flux.dev",
      "description": "Production Gateway"
    }
  ],
  "setOperationId": true,
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Bearer JWT token to authorize requests"
      },
      "x-service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token",
        "description": "Internal service mesh authentication token"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "System operational status and health check endpoints"
    },
    {
      "name": "Links",
      "description": "Short URL creation, retrieval, Base62 routing, and management"
    },
    {
      "name": "User",
      "description": "Authenticated user context and profile management"
    },
    {
      "name": "Analytics",
      "description": "Real-time link click metrics, time-series, and performance reporting"
    }
  ]
}