{
  "name": "@flux/emails",
  "version": "1.0.0",
  "description": "Package to manage emails",
  "type": "module",
  "scripts": {
    "dev": "bunx react-email dev --dir ./src/templates -p 3001",
    "export": "node node_modules/react-email/dist/cli/index.mjs export --pretty --dir ./src/templates --outDir ../../apps/backend/templates/emails",
    "format:check": "../../tmp/tools/biome format src",
    "lint": "../../tmp/tools/biome lint src --error-on-warnings",
    "typecheck": "tsc --noEmit --typeRoots ../openapi/node_modules/@types,./node_modules/@types --types node,react,react-dom",
    "test": "bun test src",
    "build": "tsc --typeRoots ../openapi/node_modules/@types,./node_modules/@types --types node,react,react-dom && bun run export"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-email/components": "0.0.34",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^6.3.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.3.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4"
  }
}
