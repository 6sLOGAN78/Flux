# Flux Frontend Environment Configuration

# Backend REST API Base URL
VITE_API_URL=http://localhost:8080

# Short Link Base Domain (e.g. localhost:3000 in dev, or custom domain in prod)
VITE_SHORT_DOMAIN=localhost:3000

# Frontend Application Origin URL
VITE_APP_URL=http://localhost:3000

# Clerk Authentication Publishable Key (Optional in local development)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Feature Flags
VITE_ENABLE_CLICKHOUSE_STREAM=true
VITE_ENABLE_AI_INSIGHTS=true
