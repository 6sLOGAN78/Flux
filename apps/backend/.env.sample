# API-only link policy. Replace with a hostname you own before starting the API.
# Dot-nested keys are literal environment names, loaded by the dotenv reader.
FLUX_LINKS.MANAGED_HOST=
# Optional comma-separated DNS names, normalized at startup. Subdomains deny too.
FLUX_LINKS.BLOCKED_HOSTS=

# API only: private standard-base64 encoding of exactly 32 random bytes.
# Generate with: openssl rand -base64 32; provision the same key to API replicas.
FLUX_LINKS.CURSOR_KEY=
# API-only invitation queue settings. Supply encryption keys through your secret
# manager; do not commit real keys. ENCRYPTION_KEYS is a JSON object mapping safe
# key IDs to canonical base64 strings encoding exactly 32 random bytes.
# Example shape only: {"current":"<base64-32-byte-key>"}
# ACTIVE_KEY_ID must exist in that ring. No plaintext fallback is supported.
# Retain old keys until pending intents drain or are safely re-encrypted; never
# retire a key while live ciphertext references it. Count encryption operations
# across all replicas and resends; rotate before 2^32 messages under any one key.
# NewGCMWithRandomNonce supplies a fresh 96-bit random nonce. Worker delivery
# and provider acknowledgement are implemented in the later delivery slice.
FLUX_INVITATIONS.ACTIVE_KEY_ID=
FLUX_INVITATIONS.ENCRYPTION_KEYS=
FLUX_INVITATIONS.SENDER=invites@example.test
FLUX_INVITATIONS.PUBLIC_ORIGIN=https://app.example.test
