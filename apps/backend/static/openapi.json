  "components": {
    "schemas": {
      "transport.CreateLinkRequest": {
        "additionalProperties": false,
        "description": "Public HTTP(S) destination, optional title of at most 200 Unicode characters and optional ASCII customKey, lowercased before validation and hashing. Keys use 3–64 letters, digits, underscores or hyphens and start with a letter or digit; system paths are reserved. Creation never fetches the destination.",
        "properties": {
          "customKey": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,63}$",
            "type": "string"
          },
          "destination": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "destination"
        ],
        "title": "transport.CreateLinkRequest",
        "type": "object"
      },
      "transport.CreateWorkspaceRequest": {
        "additionalProperties": false,
        "description": "Explicit workspace name; the server trims Unicode whitespace and validates 1–100 Unicode characters.",
        "properties": {
          "name": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "transport.CreateWorkspaceRequest",
        "type": "object"
      },
      "transport.HealthLiveResponse": {
