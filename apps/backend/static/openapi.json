{
  "components": {
    "schemas": {
      "transport.HealthLiveResponse": {
        "additionalProperties": false,
        "description": "Process liveness, independent of external dependencies.",
        "example": {
          "status": "alive"
        },
        "properties": {
          "status": {
            "enum": [
              "alive"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "transport.HealthLiveResponse",
        "type": "object"
      },
      "transport.HealthReadyResponse": {
        "additionalProperties": false,
        "description": "Readiness of this process and its required components. Only coarse states are exposed.",
        "example": {
          "checks": [
            {
              "name": "database",
              "state": "ready"
            }
          ],
          "status": "ready"
        },
        "properties": {
          "checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
