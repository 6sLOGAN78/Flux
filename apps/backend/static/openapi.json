{
  "openapi": "3.0.2",
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check Endpoint",
        "tags": [
          "Health"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Service operational status",
                      "example": "ok"
                    },
                    "database": {
                      "type": "string",
                      "description": "Database connectivity status",
                      "example": "connected"
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ],
                  "description": "System health check response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/links": {
      "post": {
        "summary": "Shorten a URL link",
        "tags": [
          "Links"
        ],
        "parameters": [],
        "requestBody": {
          "description": "Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "destinationUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Destination URL to shorten",
                    "example": "https://example.com/long-url"
                  },
                  "customCode": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "description": "Optional custom short code slug",
                    "example": "my-custom-alias"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Optional title for the link",
                    "example": "Product Launch Page"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Optional description",
                    "example": "Summer sale landing page"
                  }
                },
                "required": [
                  "destinationUrl"
                ],
                "description": "Input payload for creating a shortened link"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique link identifier (UUID)",
                      "example": "123e4567-e89b-12d3-a456-426614174000"
                    },
                    "shortCode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "Custom or generated Base62 short code",
                      "example": "xyz123"
                    },
                    "destinationUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "Target URL for redirection",
                      "example": "https://example.com/target-page"
                    },
                    "tenantId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Tenant identifier for multi-tenant isolation"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link creation timestamp in ISO 8601 format"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link last update timestamp in ISO 8601 format"
                    }
                  },
                  "required": [
                    "id",
                    "shortCode",
                    "destinationUrl",
                    "createdAt",
                    "updatedAt"
                  ],
                  "description": "Shortened Link entity"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid destination URL"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/links/{shortCode}": {
      "get": {
        "summary": "Get shortened link details",
        "tags": [
          "Links"
        ],
        "parameters": [
          {
            "name": "shortCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "xyz123"
            },
            "description": "Base62 short code slug"
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique link identifier (UUID)",
                      "example": "123e4567-e89b-12d3-a456-426614174000"
                    },
                    "shortCode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "Custom or generated Base62 short code",
                      "example": "xyz123"
                    },
                    "destinationUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "Target URL for redirection",
                      "example": "https://example.com/target-page"
                    },
                    "tenantId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Tenant identifier for multi-tenant isolation"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link creation timestamp in ISO 8601 format"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Link last update timestamp in ISO 8601 format"
                    }
                  },
                  "required": [
                    "id",
                    "shortCode",
                    "destinationUrl",
                    "createdAt",
                    "updatedAt"
                  ],
                  "description": "Shortened Link entity"
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Link not found"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "post": {
        "summary": "Create link category",
        "tags": [
          "Categories"
        ],
        "parameters": [],
        "requestBody": {
          "description": "Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Category name",
                    "example": "Marketing"
                  },
                  "color": {
                    "type": "string",
                    "description": "Hex color code",
                    "example": "#3b82f6"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Category description"
                  }
                },
                "required": [
                  "name",
                  "color"
                ],
                "description": "Input payload for creating a category"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Category UUID",
                      "example": "987e6543-e89b-12d3-a456-426614174000"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "Category name",
                      "example": "Marketing"
                    },
                    "color": {
                      "type": "string",
                      "description": "Hex color code",
                      "example": "#3b82f6"
                    },
                    "description": {
                      "type": "string",
                      "description": "Optional category description"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Category creation timestamp"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Category last update timestamp"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "color",
                    "createdAt",
                    "updatedAt"
                  ],
                  "description": "Category entity"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid category payload"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/campaigns": {
      "post": {
        "summary": "Create marketing campaign with UTM template",
        "tags": [
          "Campaigns"
        ],
        "parameters": [],
        "requestBody": {
          "description": "Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150,
                    "description": "Campaign name",
                    "example": "Q3 Growth Campaign"
                  },
                  "utm_source": {
                    "type": "string",
                    "description": "UTM Source",
                    "example": "twitter"
                  },
                  "utm_medium": {
                    "type": "string",
                    "description": "UTM Medium",
                    "example": "cpc"
                  },
                  "utm_campaign": {
                    "type": "string",
                    "description": "UTM Campaign",
                    "example": "q3_launch"
                  },
                  "utm_term": {
                    "type": "string",
                    "description": "UTM Term"
                  },
                  "utm_content": {
                    "type": "string",
                    "description": "UTM Content"
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Input payload for creating a campaign"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Campaign UUID"
                    },
                    "name": {
                      "type": "string",
                      "description": "Campaign title name",
                      "example": "Q3 Growth Campaign"
                    },
                    "utm_source": {
                      "type": "string",
                      "description": "Default UTM Source",
                      "example": "twitter"
                    },
                    "utm_medium": {
                      "type": "string",
                      "description": "Default UTM Medium",
                      "example": "cpc"
                    },
                    "utm_campaign": {
                      "type": "string",
                      "description": "Default UTM Campaign",
                      "example": "q3_launch"
                    },
                    "status": {
                      "type": "string",
                      "description": "Campaign operational status",
                      "example": "active"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "status"
                  ],
                  "description": "Marketing campaign entity"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid campaign payload"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/domains": {
      "post": {
        "summary": "Register custom branded domain",
        "tags": [
          "Domains"
        ],
        "parameters": [],
        "requestBody": {
          "description": "Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string",
                    "description": "Domain hostname to configure",
                    "example": "link.acme.com"
                  },
                  "custom_root_redirect": {
                    "type": "string",
                    "format": "uri",
                    "description": "Root domain fallback URL"
                  }
                },
                "required": [
                  "domain"
                ],
                "description": "Input payload for adding a custom domain"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Custom domain UUID"
                    },
                    "domain": {
                      "type": "string",
                      "description": "Branded hostname",
                      "example": "link.acme.com"
                    },
                    "verification_token": {
                      "type": "string",
                      "description": "DNS challenge verification token",
                      "example": "flux-verify=abc123"
                    },
                    "is_verified": {
                      "type": "boolean",
                      "description": "CNAME verification status",
                      "example": true
                    },
                    "ssl_status": {
                      "type": "string",
                      "description": "ACME TLS/SSL certificate status",
                      "example": "active"
                    }
                  },
                  "required": [
                    "id",
                    "domain",
                    "verification_token",
                    "is_verified",
                    "ssl_status"
                  ],
                  "description": "Custom branded domain entity"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid domain"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": [
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "description": "Authenticated user identifier",
                      "example": "usr_998127"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "description": "User email address",
                      "example": "user@example.com"
                    },
                    "status": {
                      "type": "string",
                      "description": "Session status",
                      "example": "authenticated"
                    }
                  },
                  "required": [
                    "user_id",
                    "email",
                    "status"
                  ],
                  "description": "Authenticated user session response"
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Unauthorized - Invalid JWT"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "summary": "Get global analytics summary",
        "tags": [
          "Analytics"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalClicks": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total click count across all links",
                      "example": 42150
                    },
                    "uniqueVisitors": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total unique visitor IP count",
                      "example": 31200
                    },
                    "activeLinks": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total active short links",
                      "example": 128
                    }
                  },
                  "required": [
                    "totalClicks",
                    "uniqueVisitors",
                    "activeLinks"
                  ],
                  "description": "Global analytics summary statistics"
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/links/{id}": {
      "get": {
        "summary": "Get detailed time-series metrics for a specific link",
        "tags": [
          "Links"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "123e4567-e89b-12d3-a456-426614174000"
            },
            "description": "Link UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "linkId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Target link UUID"
                    },
                    "shortCode": {
                      "type": "string",
                      "description": "Short code slug",
                      "example": "xyz123"
                    },
                    "totalClicks": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Total click count for this link",
                      "example": 1540
                    },
                    "clicksByDate": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "example": "2026-08-08"
                          },
                          "clicks": {
                            "type": "integer",
                            "minimum": 0,
                            "example": 320
                          }
                        },
                        "required": [
                          "date",
                          "clicks"
                        ]
                      },
                      "description": "Time-series daily click breakdown"
                    }
                  },
                  "required": [
                    "linkId",
                    "shortCode",
                    "totalClicks",
                    "clicksByDate"
                  ],
                  "description": "Detailed analytics metrics for a specific link"
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Link metrics not found"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
