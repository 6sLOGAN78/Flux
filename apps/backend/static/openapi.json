        "title": "transport.HealthLiveResponse",
        "type": "object"
      },
      "transport.HealthReadyResponse": {
        "additionalProperties": false,
        "description": "Readiness of this process and its required components. Only coarse states are exposed.",
        "example": {
          "checks": [
            {
              "name": "database",
              "state": "ready"
            }
          ],
          "status": "ready"
        },
        "properties": {
          "checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "ready",
                    "not_ready"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "state"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "transport.HealthReadyResponse",
        "type": "object"
      },
