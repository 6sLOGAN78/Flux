              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/transport.IdentityError"
                }
              }
            },
            "description": "503"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Resolve the current internal user",
        "tags": [
          "Identity"
        ]
      }
    },
