                },
                "state": {
                  "enum": [
                    "ready",
                    "not_ready"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "state"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "transport.HealthReadyResponse",
        "type": "object"
      },
