          "destination": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "destination"
        ],
        "title": "transport.CreateLinkRequest",
        "type": "object"
      },
      "transport.CreateWorkspaceRequest": {
        "additionalProperties": false,
        "description": "Explicit workspace name; the server trims Unicode whitespace and validates 1–100 Unicode characters.",
        "properties": {
          "name": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "transport.CreateWorkspaceRequest",
        "type": "object"
      },
      "transport.HealthLiveResponse": {
        "additionalProperties": false,
        "description": "Process liveness, independent of external dependencies.",
